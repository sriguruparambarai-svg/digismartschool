{
  "version": 2,
  "builds": [
    { "src": "api/ai.js", "use": "@vercel/node" },
    { "src": "api/extract-pdf.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/ai", "dest": "/api/ai.js" },
    { "src": "/api/extract-pdf", "dest": "/api/extract-pdf.js" },
    { "src": "/learnbot.html", "dest": "/learnbot.html" },
    { "src": "/", "dest": "/index.html" }
  ],
  "functions": {
    "api/ai.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/extract-pdf.js": {
      "maxDuration": 60,
      "memory": 3008
    }
  }
}
