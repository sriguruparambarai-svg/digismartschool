{
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/homework",
      "schedule": "30 10 * * 1-6"
    },
    {
      "path": "/api/keep-warm",
      "schedule": "*/5 2-11 * * 1-6"
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "digismartschool.com"
        }
      ],
      "destination": "https://www.digismartschool.com/$1",
      "permanent": true
    }
  ]
}
