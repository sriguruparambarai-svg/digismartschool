{
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/homework",
      "schedule": "30 10 * * 1-6"
    },
    {
      "path": "/api/keep-warm",
      "schedule": "*/5 2-11 * * 1-6"
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "digismartschool.com"
        }
      ],
      "destination": "https://www.digismartschool.com/$1",
      "permanent": true
    },
    {
      "source": "/test_login.html",
      "destination": "/login.html",
      "permanent": false
    },
    {
      "source": "/test-voice.html",
      "destination": "/login.html",
      "permanent": false
    },
    {
      "source": "/ROLLBACK-math-class.html",
      "destination": "/login.html",
      "permanent": false
    },
    {
      "source": "/CACHED-math-class.html",
      "destination": "/login.html",
      "permanent": false
    },
    {
      "source": "/content-setup.html",
      "destination": "/login.html",
      "permanent": false
    },
    {
      "source": "/textbook-viewer.html",
      "destination": "/login.html",
      "permanent": false
    },
    {
      "source": "/voice-demo.html",
      "destination": "/login.html",
      "permanent": false
    },
    {
      "source": "/teacher-tools-preview.html",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/dashboard-preview.html",
      "destination": "/dashboard.html",
      "permanent": false
    },
    {
      "source": "/school-admin-preview.html",
      "destination": "/dashboard.html",
      "permanent": false
    }
  ]
}
