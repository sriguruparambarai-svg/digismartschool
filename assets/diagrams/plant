<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 440 340" style="background:transparent">
  <!-- Cell Wall (outer) -->
  <rect x="30" y="18" width="380" height="298" rx="10"
        fill="rgba(168,230,168,0.04)" stroke="#a8e6a8" stroke-width="3"
        stroke-linecap="round"/>

  <!-- Cell Membrane (inner) -->
  <rect x="42" y="30" width="356" height="274" rx="6"
        fill="rgba(245,232,122,0.03)" stroke="#f5e87a" stroke-width="1.4"
        stroke-dasharray="6 4" stroke-linecap="round"/>

  <!-- Nucleus -->
  <ellipse cx="220" cy="168" rx="52" ry="44"
           fill="rgba(168,216,240,0.10)" stroke="#a8d8f0" stroke-width="2"/>
  <!-- Nuclear membrane -->
  <ellipse cx="220" cy="168" rx="44" ry="36"
           fill="none" stroke="#a8d8f0" stroke-width="1"
           stroke-dasharray="5 3"/>
  <!-- Nucleolus -->
  <circle cx="220" cy="168" r="10"
          fill="rgba(168,216,240,0.25)" stroke="#a8d8f0" stroke-width="1.2"/>

  <!-- Chloroplast 1 -->
  <ellipse cx="110" cy="110" rx="34" ry="18"
           fill="rgba(168,230,168,0.18)" stroke="#a8e6a8" stroke-width="1.8"/>
  <!-- Chloroplast grana lines -->
  <line x1="85" y1="110" x2="135" y2="110"
        stroke="#a8e6a8" stroke-width="0.8" stroke-dasharray="3 2"/>

  <!-- Chloroplast 2 -->
  <ellipse cx="330" cy="110" rx="30" ry="16"
           fill="rgba(168,230,168,0.18)" stroke="#a8e6a8" stroke-width="1.8"/>

  <!-- Chloroplast 3 -->
  <ellipse cx="110" cy="240" rx="28" ry="14"
           fill="rgba(168,230,168,0.15)" stroke="#a8e6a8" stroke-width="1.5"/>

  <!-- Large Central Vacuole -->
  <ellipse cx="220" cy="215" rx="76" ry="48"
           fill="rgba(212,160,240,0.07)" stroke="#d4a0f0" stroke-width="1.8"/>

  <!-- Mitochondria 1 -->
  <ellipse cx="330" cy="240" rx="26" ry="14"
           fill="rgba(244,160,160,0.12)" stroke="#f4a0a0" stroke-width="1.5"/>
  <!-- Cristae -->
  <path d="M314,240 Q322,232 330,240 Q338,248 346,240"
        fill="none" stroke="#f4a0a0" stroke-width="0.8"/>

  <!-- Mitochondria 2 -->
  <ellipse cx="370" cy="168" rx="20" ry="11"
           fill="rgba(244,160,160,0.12)" stroke="#f4a0a0" stroke-width="1.3"/>

  <!-- Ribosome dots -->
  <circle cx="160" cy="80" r="3" fill="#f5e87a" stroke="none"/>
  <circle cx="175" cy="72" r="3" fill="#f5e87a" stroke="none"/>
  <circle cx="270" cy="78" r="3" fill="#f5e87a" stroke="none"/>
  <circle cx="285" cy="88" r="3" fill="#f5e87a" stroke="none"/>

  <!-- Golgi apparatus -->
  <path d="M60,168 C65,158 75,156 80,168 C85,180 75,184 70,178"
        fill="none" stroke="#f4a0a0" stroke-width="1.4" stroke-linecap="round"/>
  <path d="M63,168 C68,160 76,158 81,168 C86,178 77,182 73,176"
        fill="none" stroke="#f4a0a0" stroke-width="1.2" stroke-linecap="round"/>

  <!-- LABELS -->
  <text x="220" y="308" text-anchor="middle" font-family="Kalam,cursive"
        font-size="15" font-weight="700" fill="#f5e87a">Plant Cell</text>
  <text x="18" y="58" font-family="Kalam,cursive" font-size="9" fill="#a8e6a8">Cell Wall</text>
  <text x="220" y="168" text-anchor="middle" dominant-baseline="central"
        font-family="Kalam,cursive" font-size="10" font-weight="700" fill="#a8d8f0">Nucleus</text>
  <text x="110" y="108" text-anchor="middle" dominant-baseline="central"
        font-family="Kalam,cursive" font-size="9" fill="#a8e6a8">Chloroplast</text>
  <text x="220" y="215" text-anchor="middle" dominant-baseline="central"
        font-family="Kalam,cursive" font-size="9" fill="#d4a0f0">Vacuole</text>
  <text x="330" y="238" text-anchor="middle" dominant-baseline="central"
        font-family="Kalam,cursive" font-size="9" fill="#f4a0a0">Mitochondria</text>
  <text x="60" y="192" text-anchor="middle" font-family="Kalam,cursive"
        font-size="8" fill="#f4a0a0">Golgi</text>
  <text x="220" y="330" text-anchor="middle" font-family="Kalam,cursive"
        font-size="8" fill="#c8c4be">Eukaryotic Cell — Found in Plants</text>
</svg>
