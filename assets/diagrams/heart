<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 370" style="background:transparent">
  <defs>
    <marker id="arr-h" markerWidth="7" markerHeight="7" refX="5" refY="3.5" orient="auto">
      <polygon points="0 0,7 3.5,0 7" fill="#f4a0a0"/>
    </marker>
    <marker id="arr-b" markerWidth="7" markerHeight="7" refX="5" refY="3.5" orient="auto">
      <polygon points="0 0,7 3.5,0 7" fill="#a8d8f0"/>
    </marker>
  </defs>

  <!-- Outer heart shape -->
  <path d="M200,85 C200,62 176,42 150,50 C112,60 98,102 100,134
           C102,166 122,192 148,216 L200,268 L252,216
           C278,192 298,166 300,134 C302,102 288,60 250,50
           C224,42 200,62 200,85 Z"
        fill="rgba(244,160,160,0.07)" stroke="#f4a0a0" stroke-width="2.2"
        stroke-linecap="round" stroke-linejoin="round"/>

  <!-- Septum divider -->
  <path d="M200,90 L200,232"
        fill="none" stroke="#f5e87a" stroke-width="1.8"
        stroke-dasharray="6 4" stroke-linecap="round"/>

  <!-- Left ventricle -->
  <path d="M165,148 C162,165 164,182 172,196 L200,225 L200,148 Z"
        fill="rgba(244,160,160,0.10)" stroke="#f4a0a0" stroke-width="1.4"
        stroke-linecap="round"/>

  <!-- Right ventricle -->
  <path d="M235,148 C238,165 236,182 228,196 L200,225 L200,148 Z"
        fill="rgba(168,216,240,0.10)" stroke="#a8d8f0" stroke-width="1.4"
        stroke-linecap="round"/>

  <!-- Aorta -->
  <path d="M185,76 C180,56 170,40 158,30"
        fill="none" stroke="#a8e6a8" stroke-width="7"
        stroke-linecap="round"/>

  <!-- Pulmonary artery -->
  <path d="M215,76 C220,56 230,40 242,30"
        fill="none" stroke="#d4a0f0" stroke-width="5.5"
        stroke-linecap="round"/>

  <!-- Superior vena cava -->
  <path d="M175,90 C165,72 155,55 148,40"
        fill="none" stroke="#a8d8f0" stroke-width="5"
        stroke-linecap="round"/>

  <!-- Blood flow arrow left -->
  <line x1="168" y1="128" x2="168" y2="162"
        stroke="#f4a0a0" stroke-width="1.5" stroke-linecap="round"
        marker-end="url(#arr-h)"/>

  <!-- Blood flow arrow right -->
  <line x1="232" y1="128" x2="232" y2="162"
        stroke="#a8d8f0" stroke-width="1.5" stroke-linecap="round"
        marker-end="url(#arr-b)"/>

  <!-- Coronary arteries hint -->
  <path d="M200,115 C215,120 225,132 222,148"
        fill="none" stroke="#f5e87a" stroke-width="1.2"
        stroke-dasharray="4 3" stroke-linecap="round"/>
  <path d="M200,115 C185,120 175,132 178,148"
        fill="none" stroke="#f5e87a" stroke-width="1.2"
        stroke-dasharray="4 3" stroke-linecap="round"/>

  <!-- LABELS — will fade in after drawing -->
  <text x="200" y="302" text-anchor="middle" font-family="Kalam,cursive"
        font-size="16" font-weight="700" fill="#f5e87a">Human Heart</text>
  <text x="155" y="195" text-anchor="middle" font-family="Kalam,cursive"
        font-size="10" fill="#f4a0a0">Left Ventricle</text>
  <text x="248" y="195" text-anchor="middle" font-family="Kalam,cursive"
        font-size="10" fill="#a8d8f0">Right Ventricle</text>
  <text x="200" y="165" text-anchor="middle" font-family="Kalam,cursive"
        font-size="9" fill="#f5e87a">Septum</text>
  <text x="148" y="26" text-anchor="middle" font-family="Kalam,cursive"
        font-size="9" fill="#a8e6a8">Aorta</text>
  <text x="252" y="26" text-anchor="middle" font-family="Kalam,cursive"
        font-size="9" fill="#d4a0f0">Pulmonary Artery</text>
  <text x="136" y="36" text-anchor="end" font-family="Kalam,cursive"
        font-size="9" fill="#a8d8f0">Vena Cava</text>
  <text x="200" y="340" text-anchor="middle" font-family="Kalam,cursive"
        font-size="9" fill="#c8c4be">Red = Oxygenated  |  Blue = Deoxygenated</text>
</svg>
