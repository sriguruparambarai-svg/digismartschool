{
  "functions": {
    "api/ai.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/extract-pdf.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/api/ai", "dest": "/api/ai.js" },
    { "src": "/api/extract-pdf", "dest": "/api/extract-pdf.js" },
    { "src": "/learnbot.html", "dest": "/learnbot.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}
